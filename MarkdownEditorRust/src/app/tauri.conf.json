{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MarkdownEditor",
  "mainBinaryName": "MarkdownEditor",
  "version": "2.3.0",
  "identifier": "net.vetter-net.MarkdownEditor",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Markdown editor with live preview",
    "longDescription": "A Markdown editor with syntax highlighting, live HTML preview (mermaid diagrams, LaTeX formulas), IntelliSense and PDF/HTML export.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown Document",
        "description": "Markdown Document",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": { "depends": [] }
    }
  }
}
